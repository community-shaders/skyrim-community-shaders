+    {
+        const SConstantBufferShadow New =
+        {
+            ppCBs[i],
+            pFirstConstant ? pFirstConstant[i] : 0u,
+            pNumConstants ? pNumConstants[i] : (UINT)D3D10_REQ_CONSTANT_BUFFER_ELEMENT_COUNT,
+        };
+        auto& Slot = m_CBShadow[Stage][StartSlot + i];
+        if (Slot.pBuffer != New.pBuffer || Slot.FirstConstant != New.FirstConstant || Slot.NumConstants != New.NumConstants)
+        {
+            Slot = New;
+            bAllSame = false;
+        }
+    }
+    return bAllSame;
