+    // A recursive mutex that stays inline.
+    //
+    // std::recursive_mutex reaches into msvcp_win for every lock and unlock -- Mtx_lock and
+    // Mtx_unlock, each of which calls GetCurrentThreadId in kernel32 to track recursion -- and the
+    // batched context takes one per translated D3D11 command, roughly 63,000 times a frame. All of
+    // that shows up in a profile as cross-module call frames around a single SRWLOCK operation.
+    //
+    // The owner field is read without holding the lock. That is the standard pattern and it is
+    // sound: a thread only ever writes its own id there while it holds the lock, and clears it
+    // before releasing, so another thread can read a stale value but never its own id.
+    class RecursiveSRWLock
+    {
+    public:
+        RecursiveSRWLock() = default;
+        RecursiveSRWLock(RecursiveSRWLock const&) = delete;
+        RecursiveSRWLock& operator=(RecursiveSRWLock const&) = delete;
+
+        void lock() noexcept
+        {
+            const DWORD self = CurrentThreadId();
+            if (m_Owner.load(std::memory_order_relaxed) == self)
+            {
+                ++m_Recursion;
+                return;
+            }
+            AcquireSRWLockExclusive(&m_Lock);
+            m_Owner.store(self, std::memory_order_relaxed);
+            m_Recursion = 1;
+        }
+
+        bool try_lock() noexcept
+        {
+            const DWORD self = CurrentThreadId();
+            if (m_Owner.load(std::memory_order_relaxed) == self)
+            {
+                ++m_Recursion;
+                return true;
+            }
+            if (!TryAcquireSRWLockExclusive(&m_Lock))
+            {
+                return false;
+            }
+            m_Owner.store(self, std::memory_order_relaxed);
+            m_Recursion = 1;
+            return true;
+        }
+
+        void unlock() noexcept
+        {
+            assert(m_Owner.load(std::memory_order_relaxed) == CurrentThreadId());
+            if (--m_Recursion == 0)
+            {
+                m_Owner.store(0, std::memory_order_relaxed);
+                ReleaseSRWLockExclusive(&m_Lock);
+            }
+        }
+
+    private:
+        // What GetCurrentThreadId does, without the call into kernel32.
+        static DWORD CurrentThreadId() noexcept
+        {
+#if defined(_M_X64) || defined(_M_AMD64)
+            return static_cast<DWORD>(__readgsdword(0x48));
+#else
+            return GetCurrentThreadId();
+#endif
+        }
+
+        SRWLOCK m_Lock = SRWLOCK_INIT;
+        std::atomic<DWORD> m_Owner{ 0 };
+        UINT m_Recursion = 0;   // only touched by the owning thread
+    };
+
