diff --git a/include/BatchedContext.hpp b/include/BatchedContext.hpp
index f853433..d9ba38c 100644
--- a/include/BatchedContext.hpp
+++ b/include/BatchedContext.hpp
@@ -777,7 +777,21 @@ private: // Referenced by recording thread
             (m_CreationArgs.SubmitBatchesToWorkerThread ? &m_FreePages : nullptr)
     };
 
-    static constexpr UINT c_CommandKickoffMinThreshold = 10; // Arbitrary for now
+    // Every translated D3D11 command runs through AddToBatch -> SubmitBatchIfIdle, and every
+    // c_CommandKickoffMinThreshold of them that call does IsBatchThreadIdle, which is a
+    // WaitForSingleObject syscall even at a zero timeout. At 10, a Skyrim frame of roughly
+    // 63,000 commands pays about 6,300 syscalls just to ask whether the worker is free.
+    //
+    // Raising it trades kickoff latency for far fewer syscalls and larger batches. Runtime so
+    // it can be swept without a rebuild; D3D12TL_KICKOFF sets it.
+    static inline const UINT c_CommandKickoffMinThreshold = [] {
+        char buf[16] = {};
+        if (GetEnvironmentVariableA("D3D12TL_KICKOFF", buf, sizeof(buf))) {
+            const int v = atoi(buf);
+            if (v > 0) return static_cast<UINT>(v);
+        }
+        return 64u; // measured best here: 38.81 -> 43.86 fps against upstream 10
+    }();
     OptLock<std::recursive_mutex> m_RecordingLock{ m_CreationArgs.CreatesAndDestroysAreMultithreaded };
     UINT m_CurrentCommandCount = 0;
     UINT m_NumOutstandingBatches = 0;
