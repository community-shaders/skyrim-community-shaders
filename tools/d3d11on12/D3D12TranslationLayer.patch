+bool BatchedContext::UpdateConstantBufferShadow(UINT Stage, UINT StartSlot, UINT NumBuffers, Resource* const* ppCBs,
+                                                CONST UINT* pFirstConstant, CONST UINT* pNumConstants) noexcept
